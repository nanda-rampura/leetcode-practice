import pytest
from arrays.can_attend_meetings import MeetingScheduler


@pytest.mark.parametrize(
    "intervals, expected",
    [
        ([[0, 30], [5, 10], [15, 20]], False),
        ([[7, 10], [2, 4]], True),
        ([], True),
        ([[1, 5]], True),
        ([[1, 4], [4, 5]], True),
        ([[1, 10], [2, 3], [3, 4]], False),
    ],
)
def test_can_attend_meetings(intervals, expected):
    sol = MeetingScheduler()
    assert sol.canAttendMeetings(intervals) == expected